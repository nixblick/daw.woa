# Platzhalter. Die echte Ablage liegt NUR auf dem Server, eine Datei je Variable:
#   /etc/daw.woa/geheimnisse/feedback/<NAME>   (root:999, 0640)
# Der Container liest das Verzeichnis read-only als /run/secrets ein.
# Nie einen echten Wert in dieses Repo schreiben.

# Fine-grained PAT, nur nixblick/daw.woa, nur Issues: Read and write, 90 Tage
GITHUB_TOKEN=<platzhalter-nur-auf-dem-server>

# Nicht geheim, setzt die Rolle als Container-Env:
GITHUB_REPO=nixblick/daw.woa
LISTEN_PORT=8081
FEEDBACK_PUBLIC_BASE=https://feedback.wironair.de
