target/

# Linux-Pakete (Paket 39): entstehen im Bau
/dist/
/packaging/linux/flatpak/cargo-sources.json

# Lokale Projekte, Mitschnitte und Logs, nie ins Repo
*.woa/
/logs/
*.log
# Halbfertige atomare Schreibvorgänge (store::write_atomic)
*.tmp

# Lokale Claude-Code-Dateien (Worktrees, persönliche Einstellungen)
/.claude/worktrees/
/.claude/settings.local.json

# >>> nixblick-geheimnisse >>>
# ─── Geheimnisse ─── zentral gepflegt, nicht von Hand ändern ───
# Quelle: nix.stack/shared/snippets/gitignore-secrets.txt
# Einspielen/aktualisieren: nix.stack/shared/scripts/gitignore-secrets.sh <repo>
# Grundsatz: Credentials liegen in ~/.secrets/ und werden per Symlink eingebunden.
# Siehe nix.stack/docs/secrets.md

# Umgebungsdateien
.env
.env.*
*.env
!.env.example
!.env.sample
!.env.template
!*.env.example
!*.env.sample

# Schlüssel und Zertifikate (öffentliche Teile bleiben erlaubt)
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
!*.pub.pem
!*.pub.key

# SSH-Schlüssel
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.ppk
!*.pub

# Ansible-Vault-Passwörter
.vault_pass
.vault_pass.txt
vault_pass*.txt
*vault-pass*.txt

# Benannte Geheimnis-Dateien (verschlüsselte Fassungen bleiben erlaubt)
secrets.env
secrets.json
secrets.yml
secrets.yaml
secrets.txt
credentials.json
credentials.yml
credentials.yaml
!*.enc
!*.gpg
!*.age

# Sonstiges
.netrc
.pgpass
.htpasswd
*.kdbx
# <<< nixblick-geheimnisse <<<

# Öffentliches Repo (André, 30.10.2026): interne Runbooks, Mitbewerber-Analysen und
# geklonte Referenz-Repos bleiben lokal.
/docs/intern/
/.refs/
*mitbewerber*
*.local.md
